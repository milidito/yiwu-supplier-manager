{
  "name": "yiwu-supplier-manager",
  "version": "0.4.0",
  "description": "Offline-first mobile PWA for capturing and comparing Yiwu market suppliers",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run tests/unit",
    "test:integration": "bash tests/integration/run.sh",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
